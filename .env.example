# ==============================================================================
# LearnSphere Environment Configuration
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-cryptographically-secure-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,learnsphere.io

# Tier 3 - Database: MongoDB Connection Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_NAME=learnsphere_db
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_TIMEOUT_MS=5000

# Cache, Rate Limiting & Queue: Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Trusted Reverse Proxy IPs (for secure X-Forwarded-For parsing)
TRUSTED_PROXIES=127.0.0.1,::1

# Security & Authentication (Argon2id + Short-lived JWT)
JWT_SECRET=replace-with-strong-jwt-secret-min-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Granular Rate Limits
RATE_LIMIT_LOGIN=5
RATE_LIMIT_AI=50
RATE_LIMIT_API=120
RATE_LIMIT_DEFAULT=300

# Seeding & Initial Administrative Access
SEED_DEMO_DATA=0
DEMO_ADMIN_PASSWORD=
DEMO_EDUCATOR_PASSWORD=
DEMO_STUDENT_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@learnsphere.io
BOOTSTRAP_ADMIN_PASSWORD=

# Object Storage (MinIO / S3 for video streams and lab assets)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminsecret
S3_BUCKET_NAME=learnsphere-media
